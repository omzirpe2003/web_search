
OPENAI_API_KEY=your_openai_api_key_here

MODEL=gpt-5                     # any Responses-API model that supports web_search (e.g. gpt-5, gpt-4.1)
TZ=Asia/Kolkata                 # timezone used to resolve "last Tuesday"; defaults to system tz
MEMORY_PATH=./data/memory.json  # where past conversations are stored
MEMORY_CHAR_BUDGET=60000        # max characters of past conversations put in context
MAX_SEARCHES=8                  # soft cap on web searches per answer (stated in the prompt)
